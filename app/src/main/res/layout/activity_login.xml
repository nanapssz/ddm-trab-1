<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white_quente"
    tools:context=".ui.LoginActivity">

    <ImageView
        android:id="@+id/imgTopoLogin"
        android:layout_width="423dp"
        android:layout_height="325dp"
        android:adjustViewBounds="true"
        android:contentDescription="Imagem de produtos de beleza"
        android:scaleType="fitXY"
        android:src="@drawable/img_login_topo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/cardLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/off_white_quente"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp"
        app:layout_constraintTop_toBottomOf="@id/imgTopoLogin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTituloLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bem vinda de volta!"
            android:textAlignment="gravity"
            android:textColor="@color/marrom_quase_preto"
            android:textSize="22sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/txtSubtituloLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Entre para continuar"
            android:textAlignment="gravity"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="300dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/fundo_input"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="8dp"
            android:hint="seu@email.com"
            android:inputType="textEmailAddress"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/marrom_quase_preto"
            android:textColorHint="@color/texto_secundario"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/containerSenha"
            android:layout_width="300dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/inputSenha"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fundo_input"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="8dp"
                android:hint="Insira sua senha"
                android:inputType="textPassword"
                android:paddingStart="10dp"
                android:paddingEnd="38dp"
                android:textColor="@color/marrom_quase_preto"
                android:textColorHint="@color/texto_secundario"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/btnVerSenha"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_eye_off"
                app:tint="@color/bege_acinzentado" />

        </FrameLayout>

        <TextView
            android:id="@+id/txtEsqueceuSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginTop="8dp"
            android:text="Esqueceu sua senha?"
            android:textColor="@color/terracota_marrom"
            android:textSize="10sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEntrar"
            android:layout_width="239dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/fundo_botao_marrom"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCriarConta"
            android:layout_width="239dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/fundo_botao_borda"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="Criar Conta"
            android:textAllCaps="false"
            android:textColor="@color/terracota_marrom"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>