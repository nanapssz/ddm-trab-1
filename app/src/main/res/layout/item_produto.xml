<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/containerImagemProduto"
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:background="@drawable/fundo_card">

        <ImageView
            android:id="@+id/imgProdutoItem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_background" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/terracota_marrom" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtNomeProdutoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:text="Nome do Produto"
        android:textColor="@color/marrom_quase_preto"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtPrecoProdutoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="R$ 00,00"
        android:textColor="@color/dourado_envelhecido"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>