<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/conta_fundo_topo"
    tools:context=".MinhaContaActivity">

    <ScrollView
        android:id="@+id/scrollMinhaConta"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/menuInferiorConta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/conta_fundo_topo"
            android:orientation="vertical">

            <!-- CABEÇALHO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnVoltarConta"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:src="@drawable/ic_back"
                        app:tint="@color/marrom_quase_preto" />

                    <TextView
                        android:id="@+id/txtTituloMinhaConta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="Minha conta"
                        android:textColor="@color/marrom_quase_preto"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnConfiguracoesConta"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/marrom_quase_preto" />

                </LinearLayout>

                <!-- PERFIL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/fundo_avatar_conta">

                        <ImageView
                            android:id="@+id/imgPerfilConta"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_user"
                            app:tint="@color/verde_profundo" />

                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtNomeUsuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Camila Souza" />

                        <TextView
                            android:id="@+id/txtEmailUsuario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/bege_acinzentado"
                            android:textSize="10sp"
                            tools:text="camila.souza@email.com" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_card_conta"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="22dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <!-- ABAS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/abaMeusDados"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="Meus dados"
                        android:textColor="@color/dourado_envelhecido"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/abaMeusPedidos"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="Meus Pedidos"
                        android:textColor="@color/bege_acinzentado"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/abaAtendimento"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical|end"
                        android:includeFontPadding="false"
                        android:text="Atendimento"
                        android:textColor="@color/bege_acinzentado"
                        android:textSize="9sp" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="5dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_gravity="bottom"
                        android:background="@color/conta_linha" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="1.5dp"
                        android:layout_gravity="bottom|start"
                        android:background="@color/terracota_marrom" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:text="Cadastro"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- NOME -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:includeFontPadding="false"
                    android:text="Nome completo *"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtNomeCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/fundo_input_conta"
                    android:hint="Nome completo"
                    android:includeFontPadding="false"
                    android:inputType="textPersonName"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/conta_texto_input"
                    android:textColorHint="@color/texto_secundario"
                    android:textSize="10sp"
                    tools:text="Camila Silva Alves" />

                <!-- CPF / RG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="CPF *"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtCpf"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="CPF"
                            android:includeFontPadding="false"
                            android:inputType="number"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp"
                            tools:text="854.009.163-17" />

                    </LinearLayout>

                    <Space
                        android:layout_width="34dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="RG"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtRg"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="RG"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp"
                            tools:text="854.009.163-17" />

                    </LinearLayout>

                </LinearLayout>

                <!-- SEXO / DATA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Sexo"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtSexo"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="Sexo"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp"
                            tools:text="Feminino" />

                    </LinearLayout>

                    <Space
                        android:layout_width="34dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Data de Nascimento"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtDataNascimento"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="dd/mm/aaaa"
                            android:includeFontPadding="false"
                            android:inputType="date"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp"
                            tools:text="02/06/1982" />

                    </LinearLayout>

                </LinearLayout>

                <!-- TELEFONES -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Telefone Celular *"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtTelefoneCelular"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="Celular"
                            android:includeFontPadding="false"
                            android:inputType="phone"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp"
                            tools:text="(98) 2568-9916" />

                    </LinearLayout>

                    <Space
                        android:layout_width="34dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="Telefone Secundário"
                            android:textColor="@color/marrom_quase_preto"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/edtTelefoneSecundario"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/fundo_input_conta"
                            android:hint="Telefone"
                            android:includeFontPadding="false"
                            android:inputType="phone"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/conta_texto_input"
                            android:textColorHint="@color/texto_secundario"
                            android:textSize="10sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- ENDEREÇO -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:includeFontPadding="false"
                    android:text="Endereços"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:includeFontPadding="false"
                    android:text="CEP"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtCep"
                    android:layout_width="134dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/fundo_input_conta"
                    android:hint="CEP"
                    android:includeFontPadding="false"
                    android:inputType="textPostalAddress"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/conta_texto_input"
                    android:textColorHint="@color/texto_secundario"
                    android:textSize="10sp"
                    tools:text="65040-101" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:includeFontPadding="false"
                    android:text="Endereço"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/fundo_input_conta"
                    android:hint="Endereço"
                    android:includeFontPadding="false"
                    android:inputType="textPostalAddress"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/conta_texto_input"
                    android:textColorHint="@color/texto_secundario"
                    android:textSize="10sp"
                    tools:text="Av. Silva Jardim" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="24dp"
                    android:backgroundTint="@color/dourado_envelhecido"
                    android:text="Salvar alterações"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:id="@+id/menuInferiorConta"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="@color/off_white_quente"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/menuHomeConta"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_home"
            app:tint="@color/texto_secundario" />

        <ImageView
            android:id="@+id/menuFavoritosConta"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart"
            app:tint="@color/texto_secundario" />

        <ImageView
            android:id="@+id/menuCarrinhoConta"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_cart"
            app:tint="@color/texto_secundario" />

        <ImageView
            android:id="@+id/menuUsuarioConta"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_user"
            app:tint="@color/dourado_envelhecido" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>