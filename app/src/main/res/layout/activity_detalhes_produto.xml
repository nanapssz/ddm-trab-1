<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white_quente"
    tools:context=".ui.DetalhesProdutoActivity">

    <ScrollView
        android:id="@+id/scrollDetalhes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/barraCompra"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TOPO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnVoltar"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_back"
                    app:tint="@color/marrom_quase_preto" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Detalhes do produto"
                    android:textAlignment="center"
                    android:textColor="@color/marrom_quase_preto"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/btnCompartilhar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/marrom_quase_preto" />
            </LinearLayout>

            <!-- IMAGEM DO PRODUTO (Aumentamos um pouco a altura para preencher melhor) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/fundo_card">

                <ImageView
                    android:id="@+id/imgProdutoDetalhe"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/btnFavoritar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/fundo_circulo_claro"
                    android:padding="7dp"
                    android:src="@drawable/ic_heart_border"
                    app:tint="@color/terracota_marrom" />
            </FrameLayout>

            <!-- NOME DO PRODUTO -->
            <TextView
                android:id="@+id/txtNomeProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/marrom_quase_preto"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Nome do Produto" />

            <!-- AVALIAÇÃO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ ★ ★ ★ ☆"
                    android:textColor="@color/dourado_envelhecido"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="(4.8)"
                    android:textColor="@color/texto_secundario"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- PREÇO -->
            <TextView
                android:id="@+id/txtPrecoProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/terracota_marrom"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="R$ 00,00" />

            <!-- DESCRIÇÃO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sobre o produto"
                android:textColor="@color/marrom_quase_preto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDescricaoProduto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/marrom_cafe"
                android:textSize="14sp"
                tools:text="Aqui aparecerá a descrição única vinda do Firebase." />

            <!-- Espaçador no final para não ficar colado na barra de compra -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

    <!-- BARRA INFERIOR (MANTIDA) -->
    <LinearLayout
        android:id="@+id/barraCompra"
        android:layout_width="0dp"
        android:layout_height="85dp"
        android:background="@android:color/white"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:background="@drawable/fundo_quantidade"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView android:id="@+id/btnMenos" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="−" android:textSize="20sp" />
            <TextView android:id="@+id/txtQuantidade" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="1" android:textStyle="bold" />
            <TextView android:id="@+id/btnMais" android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textSize="20sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdicionarCarrinho"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/fundo_botao_marrom"
            android:text="Adicionar ao carrinho"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>