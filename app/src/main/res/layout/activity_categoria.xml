<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white_quente"
    tools:context=".CategoriaActivity">

    <!-- TOPO -->
    <LinearLayout
        android:id="@+id/topoCategoria"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BARRA SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVoltarCategoria"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                app:tint="@color/marrom_quase_preto" />

            <TextView
                android:id="@+id/txtTituloCategoria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Categoria"
                android:textColor="@color/marrom_quase_preto"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFiltroCategoria"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@android:color/transparent"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_filtro"
                app:tint="@color/marrom_quase_preto" />

        </LinearLayout>

        <!-- CATEGORIAS FIXAS DO APP -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipTudo"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/fundo_categoria_selecionada"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Tudo"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipSkincare"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/fundo_categoria_nao_selecionada"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Skincare"
                    android:textColor="@color/terracota_marrom"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipMaquiagem"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/fundo_categoria_nao_selecionada"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Maquiagem"
                    android:textColor="@color/terracota_marrom"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipCabelos"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/fundo_categoria_nao_selecionada"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Cabelos"
                    android:textColor="@color/terracota_marrom"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/chipPerfume"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/fundo_categoria_nao_selecionada"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Perfumes"
                    android:textColor="@color/terracota_marrom"
                    android:textSize="12sp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- QUANTIDADE E ORDENAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtQtdProdutos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0 produtos encontrados"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtOrdenar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ordenar  ▾"
                android:textColor="@color/dourado_envelhecido"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- LISTA DE PRODUTOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerProdutosCategoria"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/topoCategoria"
        app:layout_constraintBottom_toTopOf="@id/dividerMenuCategoria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_produto_categoria" />

    <View
        android:id="@+id/dividerMenuCategoria"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/bordas_suaves"
        app:layout_constraintBottom_toTopOf="@id/menuInferiorCategoria"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:id="@+id/menuInferiorCategoria"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:background="@color/off_white_quente"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/menuHomeCategoria"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_home"
            app:tint="@color/dourado_envelhecido" />

        <ImageView
            android:id="@+id/menuFavoritosCategoria"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart"
            app:tint="@color/texto_secundario" />

        <ImageView
            android:id="@+id/menuCarrinhoCategoria"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_cart"
            app:tint="@color/texto_secundario" />

        <ImageView
            android:id="@+id/menuContaCategoria"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:contentDescription="@null"
            android:src="@drawable/ic_user"
            app:tint="@color/texto_secundario" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>